# Copiar este archivo a backend/.env y ajustar los valores.
# Nunca commitear .env ni credenciales reales.

APP_NAME=TecBot API

# true|false
DEBUG=true

# Orígenes permitidos para CORS, separados por comas
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Directorio del corpus ficticio de demostración.
# Por defecto: <raíz del repo>/documentos-demo (calculado desde backend/app/config.py).
# CORPUS_DIR=../documentos-demo

# Directorio de persistencia de ChromaDB (por defecto: data/chroma).
# CHROMA_DIR=data/chroma

# Servidor local de Ollama y modelos usados por la consulta.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_CHAT_MODEL=llama3.2

# Tiempo máximo de una consulta, en segundos (RNF-01).
# CONSULTA_TIMEOUT_S=12
