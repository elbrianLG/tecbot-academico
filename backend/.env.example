# Copiar este archivo a backend/.env y ajustar los valores.
# Nunca commitear .env ni credenciales reales.

APP_NAME=TecBot API

# true|false
# Advertencia: con DEBUG=true, Starlette usa su debug_response y omite el
# handler de Exception; eso rompe CA-16 y expone la traza al cliente.
# Mantener en false.
DEBUG=false

# Orígenes permitidos para CORS. Debe ser un arreglo JSON, NO una lista
# separada por comas.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Directorio del corpus ficticio de demostración.
# Si se omite, se usa <raíz del repo>/documentos-demo.
# Si se define, debe ser una ruta sin '..', relativa a backend/ o absoluta.
# CORPUS_DIR=/ruta/absoluta/al/corpus

# Directorio de persistencia de ChromaDB (por defecto: data/chroma).
# CHROMA_DIR=data/chroma

# Servidor local de Ollama y modelos usados por la consulta.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_CHAT_MODEL=llama3.2

# Tiempo máximo de una consulta, en segundos (RNF-01).
# CONSULTA_TIMEOUT_S=12
